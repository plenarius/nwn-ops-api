# The ops API's settings. Copy to .env (chmod 600) and fill in. Only OPS_API_KEY is required; each part switches itself on when its
# settings are there, and GET /api/v1/meta/systems shows which are on.

# --- Where the API listens (compose.yaml) ---------------------------------------------------------------------------------------------------
# The control host's private (WireGuard) address. Never a public one: the API can stop your game.
OPS_API_BIND=10.0.0.1
# OPS_API_PORT=8100
# SSH_KEY_FILE=./ssh/id_ed25519
# SSH_KNOWN_HOSTS_FILE=./ssh/known_hosts

# --- Keys (Authorization: Bearer <key>). At least 16 characters; make them with `openssl rand -hex 32`. ----------------------------------
# The full key opens everything.
OPS_API_KEY=change-me-to-a-long-random-key
# The admin key opens every route too. Give it to your own tools and keep the full key in a safe, so either can be changed alone.
# OPS_API_ADMIN_KEY=
# The team key: the read routes, logs, restart and cancelling a restart. For a Discord bot or a GM page.
# OPS_API_TEAM_KEY=
# The read key: status, modules and progress (without the log lines), nothing that changes the server. For a public status page.
# OPS_API_READ_KEY=

# --- The game host, over SSH ------------------------------------------------------------------------------------------------------------
# Its private address.
GAME_HOST=10.0.0.2
# SSH_USER=nwn
# SSH_KEY_PATH=/data/ssh/id_ed25519
# The game host's public key (ssh-keyscan -t ed25519 10.0.0.2 > ssh/known_hosts). Unset, the host key is not checked.
SSH_KNOWN_HOSTS=/data/ssh/known_hosts
# Change the game's files with sudo -n (a game folder made with sudo, as in the guide's layout).
# SSH_SUDO=true
# Containers whose name contains this are the game server.
# CONTAINER_FILTER=nwserver
# The game's folder on the game host. Fills in the paths below in this layout:
#   home/modules, home/modules/.staged, home/hak, home/hak/.staged, home/tlk, home/development, logs/nwserverLog1.txt, .env
GAME_DIR=/home/nwn/game
# MOD_LIVE= / MOD_STAGE= / HAK_LIVE= / HAK_STAGE= / TLK_LIVE= / DEVELOPMENT_DIR= / LOG_FILE= / NWN_ENV_FILE=
# Coolify's own copy of the service's env file on the game host, rewritten at a deploy too (optional).
# COOLIFY_ENV_FILE=/data/coolify/services/<service uuid>/.env
# How a module name becomes a version in messages (named groups major and minor; no match: the whole name).
# MODULE_VERSION_REGEX=(?P<major>\d+)[-_.](?P<minor>\d+)$
# Run on the game host after a deploy moved the files, before the server starts (MODULE=<name> is set for it).
# DEPLOY_HOOK=
# Without Coolify: how to start the game, run on the game host.
# GAME_START_COMMAND=cd ~/game && docker compose up -d
# The game's UDP port, for counting players with the game's own status query.
# NWN_PORT=5121

# --- Coolify (the game as a Coolify service) --------------------------------------------------------------------------------------------
# COOLIFY_API_URL=http://10.0.0.1:8000
# COOLIFY_TOKEN=
# COOLIFY_SERVICE_UUID=

# --- Redis: the in-game countdown (docs/contracts/restart.md) ---------------------------------------------------------------------------
# Unset: a restart waits the countdown and restarts the container, with no warning in game.
# REDIS_URL=redis://:password@10.0.0.2:6379
# REDIS_PREFIX=nwn:
# REDIS_REPLY_TIMEOUT=5

# --- Player counts from the game database (optional; the status query is used otherwise) ------------------------------------------------
# PLAYER_COUNT_SQL=SELECT COUNT(*) FROM online_players
# MYSQL_HOST=10.0.0.2
# MYSQL_PORT=3306
# MYSQL_USER=nwn
# MYSQL_PASSWORD=
# MYSQL_DB=nwn

# --- NWNX ---------------------------------------------------------------------------------------------------------------------------------
# NWNX_IMAGE=ghcr.io/nwnxee/unified:latest
# NWNX_REPO=nwnxee/unified

# --- GitHub: releases and the repository overview ----------------------------------------------------------------------------------------
# A fine-grained token with Contents: read and write, Pull requests and Actions: read, on these repositories only.
# GITHUB_TOKEN=
# key=owner/name@branch[#workflow.yml], comma separated.
# REPOS=module=you/your-module@main#release.yml,haks=you/your-haks@main
# RELEASE_NAME={tag}
# RELEASE_TAG_REGEX=^v(\d+)\.(\d+)$
# RELEASE_TAG_FORMAT=v{major}.{minor}
# RELEASE_BUMP_MESSAGE=chore: bump version to {version} [skip ci]

# --- Game data (read-only routes for a website: character sheets, talk table, 2DAs, items). Off unless GAME_NWN_ROOT is set. ---------
# Folders inside the API's container (mount them read-only in compose.yaml), not paths on the game host.
# The game install (data/*.key and bifs, lang/en/data/dialog.tlk, ovr/), e.g. a copy of the server image's /nwn/data.
# GAME_NWN_ROOT=/data/game/nwn
# GAME_LANGUAGE=en
# A copy of the module and of its haks and custom talk table. The module's own hak list and talk table name are used unless set here.
# GAME_MODULE_FILE=/data/game/modules/world.mod
# GAME_HAK_DIR=/data/game/hak
# GAME_HAKS=first_hak,second_hak
# GAME_TLK_DIR=/data/game/tlk
# GAME_CUSTOM_TLK=
# GAME_OVERRIDE_DIR=
# The server's item level restriction (ILR in nwnplayer.ini): items show "Level Required" only when it is on.
# GAME_ITEM_LEVEL_RESTRICTION=true
# The vault routes (a player's character list, character sheets, retiring a character) stay off until GAME_VAULT=on. Vault folder
# names are players' CD keys, and the read key opens the listing, so switch it on only for a site that should show characters.
# GAME_VAULT=off
# The server vault on the game host, read over SSH (default GAME_DIR/home/servervault). The SSH user must be able to read it.
# SERVERVAULT=

# --- Discord announcements ----------------------------------------------------------------------------------------------------------------
# DISCORD_WEBHOOK_URL=
# DISCORD_USERNAME=Server
# DISCORD_AVATAR_URL=
# SERVER_NAME=The server
# APP_TITLE=NWN Ops API

# --- Request tracing (OpenTelemetry, app/tracing.py). Off unless an endpoint is set. ----------------------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://10.0.0.1:4318
# OTEL_SERVICE_NAME=nwn-ops-api
# Never set OTEL_INSTRUMENTATION_HTTP_CAPTURE_HEADERS_*: requests carry the API keys in Authorization.
